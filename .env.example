APP_NAME="پنل نمایندگان"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sub.example.com
APP_KEY=
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Batch sizes only; cPanel Cron exclusively controls how often platform:tick runs.
PLATFORM_PROVIDER_OPERATION_BATCH=50
PLATFORM_USAGE_BATCH=100
PLATFORM_OUTPUT_BATCH=100
PLATFORM_RECONCILE_BATCH=100
PLATFORM_QUEUE_MAX_JOBS=200
PLATFORM_QUEUE_MAX_TIME=50
PLATFORM_PROVIDER_RETRY_MAX=8
PLATFORM_PROVIDER_RETRY_BASE=30
PLATFORM_PROVIDER_RETRY_MAX_SECONDS=1800
