APP_NAME="پنل نمایندگان"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sub.example.com
APP_KEY=
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
PLATFORM_VERSION=0.10.0-dev

# Batch sizes only; cPanel Cron exclusively controls how often platform:tick runs.
PLATFORM_PROVIDER_OPERATION_BATCH=50
PLATFORM_USAGE_BATCH=100
PLATFORM_OUTPUT_BATCH=100
PLATFORM_RECONCILE_BATCH=100
PLATFORM_PAYMENT_BATCH=50
PLATFORM_QUEUE_MAX_JOBS=200
PLATFORM_QUEUE_MAX_TIME=50
PLATFORM_PROVIDER_RETRY_MAX=8
PLATFORM_PROVIDER_RETRY_BASE=30
PLATFORM_PROVIDER_RETRY_MAX_SECONDS=1800

# Health thresholds only; these do not schedule syncs.
PLATFORM_HEALTH_PROVIDER_BATCH=100
PLATFORM_PROVIDER_STALE_SECONDS=900
PLATFORM_QUEUE_BACKLOG_WARNING=500

# Backup retention. Scheduling is still controlled only by cPanel Cron.
PLATFORM_BACKUP_KEEP_LAST=10
PLATFORM_BACKUP_MAX_BYTES=10737418240

# Update package safety limits.
PLATFORM_UPDATE_MAX_BYTES=134217728
PLATFORM_UPDATE_MAX_ENTRIES=10000
PLATFORM_UPDATE_MAX_UNCOMPRESSED_BYTES=536870912
PLATFORM_UPDATE_MAX_ENTRY_BYTES=67108864
