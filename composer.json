{
  "name": "platform/reseller",
  "description": "cPanel reseller aggregation platform",
  "type": "project",
  "require": {"php": "^8.3", "laravel/framework": "^13.0"},
  "require-dev": {"phpunit/phpunit": "^12.0", "mockery/mockery": "^1.6"},
  "autoload": {"psr-4": {"App\\": "app/", "ResellerPlatform\\": "src/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": ["@php tests/run.php", "@php vendor/bin/phpunit"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
